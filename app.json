{
  "expo": {
    "name": "Mis Finanzas",
    "slug": "mis-finanzas",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "misfinanzas",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.jared.misfinanzas",
      "supportsTablet": false,
      "infoPlist": {
        "RCTAsyncStorageExcludeFromBackup": true,
        "UIFileSharingEnabled": false,
        "LSSupportsOpeningDocumentsInPlace": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      },
      "buildNumber": "8"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jared.misfinanzas",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.USE_FINGERPRINT"
      ],
      "versionCode": 8
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Mis Finanzas",
      "shortName": "Finanzas",
      "themeColor": "#4F46E5",
      "backgroundColor": "#F6F7FB"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4F46E5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Mis Finanzas usa Face ID para que solo tú puedas abrir la app."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Mis Finanzas usa Face ID para que solo tú puedas abrir la app."
        }
      ],
      "./plugins/withOfflineRelease",
      "./plugins/withNoRemotePush",
      "./plugins/withAlignedWorkManager",
      "./plugins/withScriptSandboxOff"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/mis-finanzas"
    }
  }
}
